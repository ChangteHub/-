# ===== 数据库 =====
# 容器 MySQL root 密码（同时作为后端 DB_PASSWORD 注入）
MYSQL_ROOT_PASSWORD=change-me-strong-db-password

# ===== JWT =====
# JWT 签名密钥：至少 32 字节（256 位）的强随机值
# 生成示例：openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-random-secret!!

# ===== 应用 =====
# 允许的跨域来源（逗号分隔）；经 Nginx 同源部署时保留 localhost 默认即可
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# 管理员初始密码（可选；留空则后端随机生成并打印一次到启动日志）
ADMIN_PASSWORD=

# ===== 本地裸机开发（不使用 Docker 时，由 application-dev.yml 消费）=====
# DB_URL / DB_USERNAME / DB_PASSWORD / JWT_SECRET 均可用环境变量覆盖 dev profile 默认值
